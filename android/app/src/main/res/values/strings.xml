<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Unscroll</string>

    <!-- Block screen -->
    <string name="block_title">%1$s is resting</string>
    <string name="block_limit_message">You\'ve used today\'s time. It opens again tomorrow.</string>
    <string name="block_opens_message">You\'ve opened it as often as you planned today.</string>
    <string name="block_focus_message">You\'re in a focus session.</string>
    <string name="block_quick_message">You asked for a quiet moment.</string>
    <string name="block_schedule_message">It\'s paused by your schedule.</string>
    <string name="block_always_message">You chose to keep this app away.</string>
    <string name="block_site_title">This site is resting</string>
    <string name="block_site_message">You chose to block it in Unscroll.</string>
    <string name="block_until">Back at %1$s.</string>
    <string name="go_home">Go to home screen</string>
    <string name="go_back">Go back</string>
    <string name="five_more_minutes">5 more minutes</string>

    <!-- Mindful pause -->
    <string name="pause_title">Take a breath first</string>
    <plurals name="pause_opens">
        <item quantity="one">First time opening %1$s today.</item>
        <item quantity="other">You\'ve opened %1$s %2$d times today.</item>
    </plurals>
    <string name="pause_leave">I don\'t need it</string>
    <string name="pause_wait">Continue in %1$d s</string>
    <string name="pause_continue">Continue</string>

    <!-- Notifications -->
    <string name="channel_guard">Protection status</string>
    <string name="channel_alerts">Limits and focus</string>
    <string name="guard_text">Protecting your time</string>
    <string name="guard_focus">Focus session running</string>
    <plurals name="limit_warning">
        <item quantity="one">%1$s: %2$d minute left today</item>
        <item quantity="other">%1$s: %2$d minutes left today</item>
    </plurals>
    <string name="focus_done_title">Focus session complete</string>
    <string name="focus_done_text">Nice work. Your apps are back.</string>

    <!-- Accessibility service (shown in Android settings) -->
    <string name="accessibility_label">Unscroll blocking</string>
    <string name="accessibility_description">Lets Unscroll notice which app or browser site is open so it can show the pause or block screen you set up. It only checks app names and the browser address bar against your own rules, on this phone. It never records what you type or read and sends nothing anywhere.</string>
    <string name="fgs_subtype">Keeps the user\'s own app limits, schedules and focus sessions active while other apps are open; shows focus countdown.</string>
</resources>

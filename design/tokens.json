  },
  "motion": {
    "fast": { "ms": 120, "curve": "cubic-bezier(0.2, 0, 0, 1)" },
    "standard": { "ms": 240, "curve": "cubic-bezier(0.2, 0, 0, 1)" },
    "emphasized": { "ms": 400, "curve": "cubic-bezier(0.05, 0.7, 0.1, 1)" },
    "breath": { "inhaleMs": 4000, "holdMs": 1000, "exhaleMs": 5000 },
    "reduceMotion": "replace movement with opacity fades; breathing becomes a static countdown"
  },
  "size": { "touchTarget": 48, "iconSm": 16, "iconMd": 20, "iconLg": 24, "appIcon": 40, "bottomNav": 72 }

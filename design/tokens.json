    "license": "OFL-1.1 (bundled offline)",
    "scale": {
      "display": { "size": 44, "weight": 700, "lineHeight": 1.05, "letterSpacing": -1.2 },
      "headline": { "size": 28, "weight": 700, "lineHeight": 1.15, "letterSpacing": -0.6 },
      "title": { "size": 20, "weight": 600, "lineHeight": 1.25, "letterSpacing": -0.2 },
      "subtitle": { "size": 16, "weight": 600, "lineHeight": 1.3, "letterSpacing": 0 },
      "body": { "size": 15, "weight": 400, "lineHeight": 1.5, "letterSpacing": 0 },
      "bodySmall": { "size": 13, "weight": 400, "lineHeight": 1.45, "letterSpacing": 0 },
      "label": { "size": 13, "weight": 600, "lineHeight": 1.2, "letterSpacing": 0.1 },
      "overline": { "size": 11, "weight": 700, "lineHeight": 1.2, "letterSpacing": 1.2, "uppercase": true }
